      "name": "msvc",
      "aliases": ["cl", "visualstudio", "visual studio", "vs"],
      "executables": ["cl.exe"],
      "version_args": [],
      "version_stderr": true,
      "notes": "cl.exe 不在 PATH，位于 VS 的 VC\\Tools\\MSVC\\<版本>\\bin\\Hostx64\\x64。定位 VS 用 vswhere.exe：& \"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -latest -property installationPath，之后配 vcvarsall.bat。"
    },
    {
